# =============================================================================
# TurboBooking - Configurazione Ambiente & Integrazioni
# =============================================================================

# --- Supabase (PostgreSQL 16 + RLS) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# --- GoHighLevel (GHL API v2 & Conversations) ---
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_CLIENT_ID=your-ghl-app-client-id
GHL_CLIENT_SECRET=your-ghl-app-client-secret
GHL_LOCATION_ID=your-default-ghl-location-id
GHL_WEBHOOK_SECRET=your-ghl-webhook-hmac-secret

# --- Meta AI & Meta Webhooks (WhatsApp Cloud API / Messenger / Instagram Direct / Leads) ---
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret-for-hmac-sha256
META_VERIFY_TOKEN=your-meta-webhook-verify-token-random-string
META_WHATSAPP_TOKEN=your-meta-whatsapp-system-user-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# --- Claude (agente prenotazioni WhatsApp in linguaggio naturale) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Contesto di Dominio / Defaults ---
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
DEFAULT_VENUE_ID=00000000-0000-0000-0000-000000000002
