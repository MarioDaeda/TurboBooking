# Supabase Configuration (Server-side only — DO NOT use NEXT_PUBLIC_ for admin keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Public/anon project key, used server-side for password sign-in. Never use the service role here.
SUPABASE_ANON_KEY=your-supabase-anon-key

# Multi-tenant default IDs
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
DEFAULT_VENUE_ID=00000000-0000-0000-0000-000000000010

# Optional server-to-server bearer credential; requires x-operator-id. Never sent to browsers.
# Rotate any previously exposed INTERNAL_API_SECRET / DASHBOARD_STAFF_SECRET.
# Staff login uses Supabase Auth + staff_memberships, not these secrets.
INTERNAL_API_SECRET=your-internal-m2m-secret
DASHBOARD_STAFF_SECRET=your-dashboard-staff-secret

# Integrations (Optional)
ANTHROPIC_API_KEY=your-anthropic-key
GHL_CLIENT_ID=your-ghl-client-id
GHL_CLIENT_SECRET=your-ghl-client-secret
META_VERIFY_TOKEN=your-meta-verify-token
META_APP_SECRET=your-meta-app-secret
META_WHATSAPP_TOKEN=your-meta-whatsapp-token
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-phone-number-id
